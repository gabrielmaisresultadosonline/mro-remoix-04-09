# ============================================================
# Backend próprio na VPS — copie para server/.env e preencha
# ============================================================

NODE_ENV=production
PORT=8787
PUBLIC_API_URL=https://api.maisresultadosonline.com.br
CORS_ORIGINS=https://maisresultadosonline.com.br,https://www.maisresultadosonline.com.br

# ---- PostgreSQL local ----
DATABASE_URL=postgres://mro:SENHA_FORTE@127.0.0.1:5432/mro
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=20000

# ---- JWT (gere com: openssl rand -hex 32) ----
JWT_SECRET=
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000
# Geradas por: npm run keys (ou scripts/generate-keys.ts)
ANON_KEY=
SERVICE_ROLE_KEY=

# ---- Storage local ----
STORAGE_ROOT=/var/www/uploads
STORAGE_MAX_BYTES=314572800
# Origens remotas usadas só como rede de segurança quando o arquivo ainda não
# está no disco (vídeos/imagens que faltaram na migração). O primeiro acesso
# baixa e grava localmente. Separe múltiplas origens por vírgula.
STORAGE_FALLBACK_URLS=
STORAGE_CACHE_FALLBACK=true


# ---- Host de funções (runtime Deno) ----
FUNCTIONS_ENABLED=true
FUNCTIONS_DIR=../supabase/functions
FUNCTIONS_BASE_PORT=9100
FUNCTIONS_TIMEOUT_MS=60000
FUNCTIONS_STARTUP_TIMEOUT_MS=60000
FUNCTIONS_IDLE_TIMEOUT_MS=900000
DENO_BIN=/usr/local/bin/deno

# ============================================================
# Variáveis que as funções esperam.
# SUPABASE_URL aponta para o PRÓPRIO backend: assim o SDK dentro
# das funções fala com o Postgres local, não com o serviço externo.
# ============================================================
SUPABASE_URL=https://api.maisresultadosonline.com.br
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgres://mro:SENHA_FORTE@127.0.0.1:5432/mro

# ---- Segredos de integração (mesmos valores de hoje) ----
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_WEB_UNLOCKER_ZONE=
DEEPSEEK_API_KEY=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
IG_ADMIN_EMAIL=
IG_ADMIN_INITIAL_PASSWORD=
IG_ADMIN_SESSION_SECRET=
INSTAGRAM_SESSION_ID=
LOVABLE_API_KEY=
META_CONVERSIONS_API_TOKEN=
MRO_ADMIN_EMAIL=
MRO_ADMIN_PASSWORD=
MRO_ADMIN_SESSION_SECRET=
RAPIDAPI_KEY=
SMTP_PASSWORD=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=suporte@maisresultadosonline.com.br
STRIPE_SECRET_KEY=
WPP_BOT_TOKEN=

# ============================================================
# Migração (preencher só enquanto o Supabase ainda existir)
# ============================================================
LEGACY_SUPABASE_URL=https://adljdeekwifwcdcgbpit.supabase.co
LEGACY_SUPABASE_SERVICE_KEY=
LEGACY_DATABASE_URL=
